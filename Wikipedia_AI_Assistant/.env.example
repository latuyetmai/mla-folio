# CA certificates  (if needed)
#SSL_CERT_FILE=<your-ssl-cert-file>
#DISABLE_SSL_VERIFY=true

# Databricks account
CATALOG=<your-dev-catalog-name>
SCHEMA=<your-dev-schema-name>
DATABRICKS_TOKEN=<your-databricks-token>
# Or using service principal client credentials (uncomment the following lines and fill in the values)
#DATABRICKS_CLIENT_SECRET=<your-databricks-client-secret>
#DATABRICKS_CLIENT_ID=<your-databricks-client-id>
DATABRICKS_HOSTNAME=<your-databricks-hostname>
DATABRICKS_HOST=<your-databricks-host>

# --- MLflow / Lakebase ---
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_ID=<your-mlflow-experiment-id>
LAKEBASE_INSTANCE_NAME=<your-lakebase-instance-name>
LAKEBASE_HOST=<your-lakebase-host>.database.cloud.databricks.com
VECTORSEARCH_ENDPOINT=<your-vectorsearch-endpoint>

## Using LangSmith for tracing (uncomment the following lines and fill in the values if you want to enable tracing)
#LANGSMITH_TRACING=true
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#LANGSMITH_PROJECT=<your-langsmith-project-name>
#
## Add API keys for connecting to LLM providers, data sources, and other integrations here
##LANGSMITH_API_KEY=<your-langsmith-api-key>

# Other LLM Providers:
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# GIT
GIT_PYTHON_REFRESH=quiet
